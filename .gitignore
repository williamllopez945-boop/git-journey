# Secrets and credentials
*.env
.env.*
*.key
*.pem
*.pfx
*.p12
*credentials*
*secret*
*secrets*
*.token
robinhood_credentials*
robinhood_token*

# Trading agent runtime state/logs (live account + trade data, never commit)
trading_agent/state.json
trading_agent/price_history.json
trading_agent/scanner_state.json
trading_agent/position_state.json
trading_agent/cycle_log.json
trading_agent/*.log
trading_agent/logs/
# trading_agent/daily_logs/*.md is NOT ignored - the daily after-action
# review is meant to be a durable, versioned record, committed each day.

# Research agent runtime state (live findings log, never commit)
research_agent/research_log.json
# research_agent/research_notes/*.md: gitignored (owner request 2026-10-05
# - local record only, no more committing research digests to git).
# research_log.json above is the durable structured record instead.
research_agent/research_notes/*.md

# Python
__pycache__/
*.pyc
.pytest_cache/

# Per-workspace development environments (never shared between agents)
.venv/

# VOLTRAP runtime state, like the other production state above
trading_agent/voltrap_state.json

